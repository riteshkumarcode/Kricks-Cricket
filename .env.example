# =============================================================================
# Krickscricket — Environment Configuration Example
# Copy this file to .env and provide real credentials for local development.
# =============================================================================

# Application (Do NOT set NODE_ENV manually; Next.js sets it automatically for dev/build/start)
NEXT_PUBLIC_APP_URL="https://krickscricket.com"

# PostgreSQL Database (Neon / Supabase / Managed PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/krickscricket?schema=public"

# Auth.js / NextAuth
NEXTAUTH_URL="https://krickscricket.com"
NEXTAUTH_SECRET="f8b4e9c2a1d73650894c1b2e3f4a5d6c7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b"

# Initial Owner Admin Seed Credentials (used by prisma/seed.ts)
ADMIN_EMAIL="admin@krickscricket.com"
ADMIN_PASSWORD="change-this-to-a-secure-password"

# Optional Google OAuth for Customer Login
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Media Storage (Cloudinary with local-disk fallback)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="krickscricket"

# Payments — Razorpay (Domestic INR, UPI, Cards, Netbanking)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Payments — Stripe (International Currencies: USD, GBP, AUD, AED, ZAR)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Shipping — Shiprocket API
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
SHIPROCKET_API_URL="https://apiv2.shiprocket.in/v1/external"

# Transactional Email (Resend or SMTP)
EMAIL_FROM="Krickscricket <orders@krickscricket.com>"
RESEND_API_KEY=""
# Or fallback SMTP:
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""

# External Currency Exchange Rates API (Optional daily cron sync)
EXCHANGE_RATES_API_KEY=""

