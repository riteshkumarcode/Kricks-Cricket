datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// =============================================================================
// 1. AUTHENTICATION & ACCESS CONTROL (Auth.js)
// =============================================================================

enum StaffRole {
  OWNER
  ADMIN
  MANAGER
  FULFILMENT
  CONTENT_EDITOR
  SUPPORT
}

model User {
  id               String        @id @default(cuid())
  name             String
  email            String        @unique
  passwordHash     String
  role             StaffRole     @default(CONTENT_EDITOR)
  twoFactorSecret  String?
  twoFactorEnabled Boolean       @default(false)
  avatarUrl        String?
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  permissions      Permission[]
  sessions         Session[]
  activityLogs     ActivityLog[]
}

model Permission {
  id        String   @id @default(cuid())
  userId    String
  module    String   // "products", "orders", "cms", "settings", etc.
  canView   Boolean  @default(false)
  canCreate Boolean  @default(false)
  canEdit   Boolean  @default(false)
  canDelete Boolean  @default(false)
  canExport Boolean  @default(false)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Customer {
  id             String            @id @default(cuid())
  email          String            @unique
  passwordHash   String?
  name           String?
  phone          String?
  isBlocked      Boolean           @default(false)
  marketingOptIn Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  addresses      CustomerAddress[]
  orders         Order[]
  cart           Cart?
  savedDesigns   SavedDesign[]
  reviews        Review[]
  notes          CustomerNote[]
}

model CustomerAddress {
  id          String   @id @default(cuid())
  customerId  String
  label       String?
  name        String
  phone       String
  street1     String
  street2     String?
  city        String
  state       String
  postalCode  String
  countryCode String   // ISO 2-letter
  isDefault   Boolean  @default(false)

  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model CustomerNote {
  id         String   @id @default(cuid())
  customerId String
  content    String
  authorName String
  createdAt  DateTime @default(now())

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

// =============================================================================
// 2. PRODUCT CATALOG & INVENTORY
// =============================================================================

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductCategoryType {
  LEATHER
  TENNIS
  ACCESSORIES
  CUSTOM
}

model Category {
  id           String              @id @default(cuid())
  slug         String              @unique
  name         String
  subTitle     String?
  description  String?
  headerPhoto  String?
  type         ProductCategoryType @default(LEATHER)
  filterConfig Json?
  guideTitle   String?
  guideContent Json?
  sortOrder    Int                 @default(0)
  showInMenu   Boolean             @default(true)
  metaTitle    String?
  metaDesc     String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  products     Product[]
}

model Product {
  id              String           @id @default(cuid())
  slug            String           @unique
  name            String
  subTitle        String
  blurb           String
  description     Json?
  categoryId      String
  category        Category         @relation(fields: [categoryId], references: [id])
  badge           String?
  tags            String[]
  status          ProductStatus    @default(ACTIVE)
  isSample        Boolean          @default(false)

  price           Int              // Minor units (INR paise: e.g. 24999 = 2499900)
  compareAtPrice  Int?

  drawingType     String?          // "bat" or accessory "kind"
  bladeColor      String?          @default("#E3C78E")
  gripColor       String?          @default("#C3262C")
  stickerColor    String?          @default("#0A0A0A")
  stickerInkColor String?          @default("#F0E3C3")
  grainsCount     Int?             @default(9)
  gradeLabel      String?          @default("ENGLISH WILLOW")

  color1          String?
  color2          String?

  specs           Json?
  allowKnockingIn Boolean          @default(false)
  allowEngraving  Boolean          @default(false)

  metaTitle       String?
  metaDescription String?
  ogImage         String?
  sortOrder       Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  images          ProductImage[]
  options         ProductOption[]
  variants        ProductVariant[]
  reviews         Review[]
  relatedTo       RelatedProduct[] @relation("SourceProduct")
  relatedFrom     RelatedProduct[] @relation("TargetProduct")
}

model ProductImage {
  id          String   @id @default(cuid())
  productId   String
  url         String
  altText     String
  focalPointX Float    @default(50.0)
  focalPointY Float    @default(50.0)
  sortOrder   Int      @default(0)

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductOption {
  id        String   @id @default(cuid())
  productId String
  name      String   // "Size", "Weight", "Fit", "Hand"
  values    String[]
  sortOrder Int      @default(0)

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVariant {
  id                String          @id @default(cuid())
  productId         String
  sku               String          @unique
  barcode           String?
  title             String
  options           Json
  price             Int
  compareAtPrice    Int?
  stock             Int             @default(0)
  lowStockThreshold Int             @default(5)
  weightGrams       Int             @default(1200)

  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  currencyPrices    VariantPrice[]
  inventoryLogs     InventoryLog[]
}

model VariantPrice {
  id           String         @id @default(cuid())
  variantId    String
  currencyCode String
  price        Int
  compareAt    Int?

  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, currencyCode])
}

model InventoryLog {
  id          String         @id @default(cuid())
  variantId   String
  delta       Int
  reason      String
  referenceId String?
  createdAt   DateTime       @default(now())

  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

model RelatedProduct {
  sourceId String
  targetId String

  source   Product @relation("SourceProduct", fields: [sourceId], references: [id], onDelete: Cascade)
  target   Product @relation("TargetProduct", fields: [targetId], references: [id], onDelete: Cascade)

  @@id([sourceId, targetId])
}

// =============================================================================
// 3. CUSTOM BAT BUILDER SETTINGS
// =============================================================================

model BuilderWillowGrade {
  id          String   @id @default(cuid())
  label       String
  price       Int      // Minor units (paise)
  bladeColor  String
  grainsCount Int
  gradeText   String
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
}

model BuilderGripColor {
  id        String   @id @default(cuid())
  name      String
  hexColor  String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
}

model BuilderStickerColor {
  id        String   @id @default(cuid())
  name      String
  hexColor  String
  textColor String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
}

model BuilderRule {
  id              String   @id @default("singleton")
  nameMaxLength   Int      @default(10)
  numMaxLength    Int      @default(3)
  knockingInPrice Int      @default(80000) // 800 INR
  leadTimeText    String   @default("Ships in 10 to 14 days")
  defaultValues   Json
  updatedAt       DateTime @updatedAt
}

model SavedDesign {
  id         String   @id @default(cuid())
  customerId String
  name       String
  config     Json
  createdAt  DateTime @default(now())

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

// =============================================================================
// 4. CART & ORDERS
// =============================================================================

enum OrderStatus {
  PENDING
  PAID
  IN_PRODUCTION
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

model Cart {
  id         String     @id @default(cuid())
  customerId String?    @unique
  guestToken String?    @unique
  currency   String     @default("INR")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items      CartItem[]
}

model CartItem {
  id            String   @id @default(cuid())
  cartId        String
  productId     String?
  variantId     String?
  name          String
  optionsText   String?
  price         Int
  quantity      Int      @default(1)

  isCustom      Boolean  @default(false)
  configuration Json?

  cart          Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  customerId      String?
  customerEmail   String
  customerPhone   String
  customerName    String

  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  currency        String        @default("INR")

  subtotal        Int
  discountTotal   Int           @default(0)
  shippingTotal   Int           @default(0)
  taxTotal        Int           @default(0)
  grandTotal      Int

  couponCode      String?
  gstin           String?

  shippingAddress Json
  billingAddress  Json
  shippingMethod  String?
  trackingNumber  String?
  trackingUrl     String?

  internalNotes   String?
  customerNotes   String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  customer        Customer?     @relation(fields: [customerId], references: [id])
  items           OrderItem[]
  payments        Payment[]
  refunds         Refund[]
  shipments       Shipment[]
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  productId     String?
  variantId     String?
  name          String
  sku           String?
  optionsText   String?
  unitPrice     Int
  quantity      Int
  lineTotal     Int

  isCustom      Boolean  @default(false)
  configuration Json?

  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Payment {
  id               String        @id @default(cuid())
  orderId          String
  gateway          String        // "RAZORPAY", "STRIPE", "COD"
  gatewayPaymentId String?
  gatewayOrderId   String?
  gatewaySignature String?
  amount           Int
  currency         String
  status           PaymentStatus @default(PENDING)
  errorMessage     String?
  createdAt        DateTime      @default(now())

  order            Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Refund {
  id              String   @id @default(cuid())
  orderId         String
  gatewayRefundId String?
  amount          Int
  currency        String
  reason          String?
  createdAt       DateTime @default(now())

  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Shipment {
  id          String   @id @default(cuid())
  orderId     String
  carrier     String   @default("Shiprocket")
  awbNumber   String?
  shipmentId  String?
  labelUrl    String?
  trackingUrl String?
  status      String   @default("CREATED")
  createdAt   DateTime @default(now())

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// =============================================================================
// 5. MARKETING, DISCOUNTS, REVIEWS & CRM
// =============================================================================

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

model Coupon {
  id        String       @id @default(cuid())
  code      String       @unique
  type      DiscountType @default(PERCENTAGE)
  value     Int
  minSpend  Int?
  maxUses   Int?
  usedCount Int          @default(0)
  startDate DateTime?
  endDate   DateTime?
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id               String       @id @default(cuid())
  productId        String
  customerId       String?
  authorName       String
  authorEmail      String
  rating           Int
  title            String?
  content          String
  status           ReviewStatus @default(PENDING)
  verifiedPurchase Boolean      @default(false)
  adminReply       String?
  createdAt        DateTime     @default(now())

  product          Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer         Customer?    @relation(fields: [customerId], references: [id])
}

enum LeadStage {
  NEW
  CONTACTED
  QUOTE_SENT
  WON
  LOST
}

model BulkEnquiry {
  id            String      @id @default(cuid())
  stage         LeadStage   @default(NEW)
  clubName      String
  country       String
  contactName   String
  email         String
  phone         String?
  neededItems   String[]
  quantity      Int         @default(20)
  logoUrl       String?
  neededByDate  DateTime?
  notes         String?
  internalNotes String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  quotes        Quote[]
}

model Quote {
  id          String      @id @default(cuid())
  enquiryId   String
  quoteNumber String      @unique
  subtotal    Int
  discount    Int
  total       Int
  currency    String      @default("INR")
  status      String      @default("DRAFT")
  pdfUrl      String?
  createdAt   DateTime    @default(now())

  enquiry     BulkEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  items       QuoteItem[]
}

model QuoteItem {
  id          String   @id @default(cuid())
  quoteId     String
  description String
  quantity    Int
  unitPrice   Int
  lineTotal   Int

  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model PricingTier {
  id          String   @id @default(cuid())
  minQuantity Int
  maxQuantity Int?
  discountPct Int
  sortOrder   Int      @default(0)
}

model ContactMessage {
  id          String   @id @default(cuid())
  name        String
  email       String
  subject     String
  orderNumber String?
  message     String
  isRead      Boolean  @default(false)
  replySent   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  isActive     Boolean  @default(true)
  subscribedAt DateTime @default(now())
}

// =============================================================================
// 6. CONTENT MANAGEMENT (CMS), NAVIGATION & HOME BUILDER
// =============================================================================

model Page {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  content         Json
  faqBlocks       Json?
  metaTitle       String?
  metaDescription String?
  isPublished     Boolean   @default(false)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model HomeBlock {
  id        String   @id @default(cuid())
  key       String   @unique
  title     String
  isVisible Boolean  @default(true)
  sortOrder Int      @default(0)
  content   Json
  updatedAt DateTime @updatedAt
}

model HeroSlide {
  id            String    @id @default(cuid())
  kicker        String
  headline1     String
  headline2     String
  subText       String
  btn1Label     String
  btn1Link      String
  btn2Label     String?
  btn2Link      String?
  progressLabel String

  imageUrl      String
  mobileImgUrl  String?
  focalPointX   Float     @default(50.0)
  focalPointY   Float     @default(40.0)

  isCustomCard  Boolean   @default(false)
  productId     String?
  cardTag       String?

  sortOrder     Int       @default(0)
  isActive      Boolean   @default(true)
  startDate     DateTime?
  endDate       DateTime?
}

model MenuItem {
  id          String   @id @default(cuid())
  label       String
  href        String
  sortOrder   Int      @default(0)
  hasMega     Boolean  @default(false)
  megaContent Json?
  mobilePhoto String?
}

model FooterColumn {
  id        String       @id @default(cuid())
  title     String
  sortOrder Int          @default(0)
  links     FooterLink[]
}

model FooterLink {
  id        String       @id @default(cuid())
  columnId  String
  label     String
  href      String
  sortOrder Int          @default(0)

  column    FooterColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
}

// =============================================================================
// 7. SYSTEM SETTINGS, CURRENCIES, SHIPPING, TAXES & AUDIT
// =============================================================================

model Currency {
  code         String   @id
  name         String
  symbol       String
  exchangeRate Float
  roundingRule String   @default("ceil")
  isDefault    Boolean  @default(false)
  isEnabled    Boolean  @default(true)
  updatedAt    DateTime @updatedAt
}

model ShippingZone {
  id            String         @id @default(cuid())
  name          String
  countries     String[]
  deliveryEst   String
  freeThreshold Int?
  rates         ShippingRate[]
}

model ShippingRate {
  id        String       @id @default(cuid())
  zoneId    String
  name      String
  rateType  String
  amount    Int
  minWeight Int?
  maxWeight Int?

  zone      ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
}

model TaxRule {
  id          String  @id @default(cuid())
  hsnCode     String
  name        String
  ratePercent Float
  isInclusive Boolean @default(true)
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model EmailTemplate {
  id         String   @id
  name       String
  subject    String
  bodyBlocks Json
  updatedAt  DateTime @updatedAt
}

model Redirect {
  id         String   @id @default(cuid())
  sourcePath String   @unique
  targetPath String
  statusCode Int      @default(301)
  createdAt  DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String   @default("System")
  module    String
  action    String
  entityId  String?
  diff      Json?
  timestamp DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id])
}

